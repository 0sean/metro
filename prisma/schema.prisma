// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Direction {
  IN
  OUT
}

enum Day {
  Weekday
  Saturday
  Sunday
}

enum Line {
  GRN
  YEL
}

model Station {
  id       Int    @id @default(autoincrement())
  name     String
  code     String
  platforms Platform[]
}

model Platform {
  id        Int    @id @default(autoincrement())
  number    Int
  direction Direction
  text      String
  station   Station   @relation(fields: [stationId], references: [id])
  stationId Int
  stops     Stop[]
}

model Service {
  id     Int  @id @default(autoincrement())
  stops  Stop[]
}

model Stop {
  id        Int    @id @default(autoincrement())
  line      Line
  time      Int
  day    Day
  platform  Platform @relation(fields: [platformId], references: [id])
  platformId Int
  service   Service?   @relation(fields: [serviceId], references: [id])
  serviceId Int?
  terminates String?
}